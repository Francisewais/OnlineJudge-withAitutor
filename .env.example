# 复制为 .env 后按需修改：cp .env.example .env

# ===== 必填：密码和密钥，部署到服务器前务必改成随机字符串（可以用 openssl rand -hex 32 生成）=====
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
JUDGE_TOKEN=change-me-judge-token
OJ_JWT_SECRET=change-me-jwt-secret

# 管理员账号，首次启动时创建；密码留空会随机生成并打印在后端日志里（docker compose logs backend）
OJ_ADMIN_USERNAME=admin
OJ_ADMIN_PASSWORD=

# ===== AI 助教（可选，不填则不显示 AI 功能）=====
# DeepSeek API Key，在 https://platform.deepseek.com/api_keys 创建
OJ_AI_API_KEY=
# 任何 OpenAI 兼容的接口都可以，例如通义千问、Kimi、本地 Ollama
OJ_AI_BASE_URL=https://api.deepseek.com
OJ_AI_MODEL=deepseek-flash
# DeepSeek 默认开启思考模式，回答慢、更贵；助教场景默认关闭。可选 enabled / disabled，其他服务商请留空
OJ_AI_THINKING=disabled
# 每个用户每天能问几次（管理员不限）
OJ_AI_DAILY_LIMIT=30

# ===== 其他 =====
# 网站名称，显示在页面左上角和标题栏
OJ_SITE_NAME=Online Judge
# 网站端口；默认只允许本机访问，要让其他电脑访问改成 OJ_BIND=0.0.0.0
OJ_PORT=8080
OJ_BIND=127.0.0.1
# 同时评测的提交数
JUDGE_CONCURRENCY=4

# 国内网络构建镜像慢的话可以填镜像源，例如：
#   APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   MAVEN_MIRROR=https://maven.aliyun.com/repository/public
#   NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple
MAVEN_MIRROR=
NPM_REGISTRY=https://registry.npmjs.org
